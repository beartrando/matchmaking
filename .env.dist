APP_NAME=matchmaking
OTEL_SERVICE_NAME=tic-tac-toe-matchmaking
APP_ENV=uat

GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/matchmaking
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/matchmaking

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=matchmaking-pg-boss

KAFKA_BROKERS=10.100.0.1:9092
KAFKA_CLIENT_ID=tic-tac-toe-matchmaking-client
KAFKA_GROUP_ID=tic-tac-toe-matchmaking-service

MESSAGE_PRODUCER_TOPIC_MATCHMAKING_MATCHED=tic-tac-toe-uat.matchmaking.matched
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
PROMETHEUS_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
